# ============================================================================
# AgentGate configuration
#
# Copy to .env and uncomment ONE provider block. Switching provider is a
# two-line edit -- never a code change.
#
#   cp .env.example .env
#
# NOTE ON FREE TIERS: token *price* is rarely the binding constraint on a free
# tier -- the requests-per-minute and tokens-per-minute ceilings are. Three
# specialist agents fire simultaneously on every review, so if a provider has a
# tight TPM ceiling, lower AGENTGATE_CONCURRENCY to 1 or 2 before you lower
# anything else. The retry layer will survive a 429, but not an endless one.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. mock -- deterministic, offline, zero cost. Used by tests and CI. (default)
# ---------------------------------------------------------------------------
AGENTGATE_PROVIDER=mock
AGENTGATE_MODEL=mock-reviewer-v1

# ---------------------------------------------------------------------------
# 2. Google Gemini (OpenAI-compatible endpoint) -- generous free tier
# ---------------------------------------------------------------------------
# AGENTGATE_PROVIDER=openai_compat
# AGENTGATE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AGENTGATE_MODEL=gemini-2.0-flash
# AGENTGATE_API_KEY=
# AGENTGATE_CONCURRENCY=3

# ---------------------------------------------------------------------------
# 3. xAI Grok
# ---------------------------------------------------------------------------
# AGENTGATE_PROVIDER=openai_compat
# AGENTGATE_BASE_URL=https://api.x.ai/v1
# AGENTGATE_MODEL=grok-3-mini
# AGENTGATE_API_KEY=
# AGENTGATE_CONCURRENCY=3

# ---------------------------------------------------------------------------
# 4. Groq -- very fast, but a tight tokens-per-minute ceiling on the free tier
# ---------------------------------------------------------------------------
# AGENTGATE_PROVIDER=openai_compat
# AGENTGATE_BASE_URL=https://api.groq.com/openai/v1
# AGENTGATE_MODEL=llama-3.3-70b-versatile
# AGENTGATE_API_KEY=
# AGENTGATE_CONCURRENCY=1

# ---------------------------------------------------------------------------
# 5. DeepSeek
# ---------------------------------------------------------------------------
# AGENTGATE_PROVIDER=openai_compat
# AGENTGATE_BASE_URL=https://api.deepseek.com/v1
# AGENTGATE_MODEL=deepseek-chat
# AGENTGATE_API_KEY=
# AGENTGATE_CONCURRENCY=3

# ---------------------------------------------------------------------------
# 6. OpenRouter -- one key, many models. The :free routes are rate-limited hard.
# ---------------------------------------------------------------------------
# AGENTGATE_PROVIDER=openai_compat
# AGENTGATE_BASE_URL=https://openrouter.ai/api/v1
# AGENTGATE_MODEL=meta-llama/llama-3.3-70b-instruct:free
# AGENTGATE_API_KEY=
# AGENTGATE_CONCURRENCY=1

# ---------------------------------------------------------------------------
# 7. Anthropic (native SDK)
# ---------------------------------------------------------------------------
# AGENTGATE_PROVIDER=anthropic
# AGENTGATE_MODEL=claude-haiku-4-5-20251001
# AGENTGATE_API_KEY=
# AGENTGATE_CONCURRENCY=3

# ============================================================================
# Shared knobs (defaults shown; all optional)
# ============================================================================

# --- generation ---
# AGENTGATE_TEMPERATURE=0.0
# AGENTGATE_MAX_OUTPUT_TOKENS=1400
# AGENTGATE_REQUEST_TIMEOUT_S=60

# --- rate-limit survival ---
# AGENTGATE_CONCURRENCY=3
# AGENTGATE_MAX_ATTEMPTS=4
# AGENTGATE_BACKOFF_BASE_S=0.5
# AGENTGATE_BACKOFF_MAX_S=20

# --- spend guards: a run aborts loudly rather than silently burning credits ---
# AGENTGATE_TOKEN_BUDGET_PER_RUN=120000
# AGENTGATE_TOKEN_BUDGET_PER_EVAL=2000000

# --- review policy ---
# AGENTGATE_MAX_FINDINGS=20
# AGENTGATE_FAIL_ON=block

# --- eval drift gate: CI fails when detection falls below this ---
# AGENTGATE_EVAL_MIN_DETECTION=0.40
# AGENTGATE_EVAL_LINE_TOLERANCE=3

# --- telemetry ---
# AGENTGATE_TRACE_FILE=runs/traces.jsonl
# AGENTGATE_TRACE_ENABLED=true

# --- mock provider: simulated latency, so the parallelism test has something to measure ---
# AGENTGATE_MOCK_LATENCY_MS=120

# ============================================================================
# GitHub integration (used by agentgate review --pr and the CI workflow)
# ============================================================================
# GITHUB_TOKEN=
